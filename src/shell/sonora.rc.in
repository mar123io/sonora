// Generated by CMake from src/shell/sonora.rc.in. Edit the .in file.
//
// Two things live here, and Windows asks for both in more places than a title
// bar. The icon is what Explorer, the taskbar, Alt-Tab and the system's media
// panel draw. The version block is what gives the executable a *name*: without
// it the media panel called this program "Unknown app", because there was
// nothing in the file to call it.
#include <windows.h>

// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST.
// Written numerically so this compiles with any resource compiler.
1 24 "@SONORA_RC_DIR@/sonora.manifest"

// Resource id 1, and it matters: the first icon by id is the one the shell
// takes for the executable. src/platform/win/window_win32.cpp loads the same id
// for the window class.
1 ICON "@SONORA_RC_DIR@/sonora.ico"

// The application's name, as a resource rather than a literal: the shell asks
// for it indirectly (@<file>,-101) when it decides what to call the program in
// the media panel and the taskbar, and a name in a string table is a name that
// can be translated. src/platform/win/window_win32.cpp references this id.
STRINGTABLE
BEGIN
  101 "Sonora"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    // 0409 = US English, 04B0 = Unicode. The pair has to match the Translation
    // value at the bottom, or the block is ignored and the file is nameless
    // again.
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Mario Lizzio"
      VALUE "FileDescription", "Sonora"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "Sonora"
      VALUE "LegalCopyright", "Copyright (C) 2026 Mario Lizzio. MIT licensed."
      VALUE "OriginalFilename", "Sonora.exe"
      VALUE "ProductName", "Sonora"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
