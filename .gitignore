# Build output
build/
out/
install/
CMakeUserPresets.json

# vcpkg
vcpkg_installed/
# The registry checkout CI makes at the pinned baseline (see .github/workflows),
# and the binary cache beside it. Both are build inputs, not sources.
.vcpkg/
.vcpkg-cache/

# CEF binary distribution (provisioned by cmake/DownloadCEF.cmake)
third_party/cef/

# Web UI (arrives in week 2)
ui/node_modules/
ui/dist/
# Generated from schema/bridge.schema.json by tools/gen_bridge.py
ui/src/bridge/generated.ts

# Editors and tooling
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.cache/
compile_commands.json

# Scratch space for pair-programming sessions: notes and staged copies, not source
Claude outputs/

# Private keys, and this line is not decoration.
#
# tools/update_keygen.ps1 writes the release key's private half to a file, and a private key
# that reaches a commit has to be treated as compromised from that moment -- rewriting the
# history does not un-publish it. The script defaults to writing outside this tree for the
# same reason; this is the second lock on the same door.
*.pem
*.key
*.pfx

# OS noise
Thumbs.db
desktop.ini
.DS_Store
